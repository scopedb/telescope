# ScopeDB connection
TELESCOPE_SCOPEDB_ENDPOINT=
TELESCOPE_SCOPEDB_API_KEY=

# Logical queued telemetry capacity per signal, default 536870912 (512 MiB).
# Size the queue volume above the sum for enabled signals plus database overhead.
#TELESCOPE_QUEUE_MAX_BYTES=536870912

# Each signal has one exporter consumer by default.
#TELESCOPE_QUEUE_CONSUMERS=1
# Collector owns the write-attempt timeout; no separate SDK deadline applies.
#TELESCOPE_WRITE_TIMEOUT=30s
# Maximum uncompressed NDJSON rows/bytes per ScopeDB append.
#TELESCOPE_APPEND_MAX_ROWS=8000
#TELESCOPE_APPEND_MAX_BYTES=4194304
# Increase both batch settings to 8000 for fewer requests under a shared quota.
#TELESCOPE_OTEL_BATCH_SIZE=2000
#TELESCOPE_OTEL_BATCH_MAX_SIZE=2000
#TELESCOPE_OTEL_BATCH_TIMEOUT=30s
