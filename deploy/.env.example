# ScopeDB connection
TELESCOPE_SCOPEDB_ENDPOINT=
TELESCOPE_SCOPEDB_API_KEY=

# Logical queued telemetry byte capacity, default 536870912 (512 MiB).
# The queue volume also holds queue database pages, so keep the volume that
# backs TELESCOPE_QUEUE_DIR larger than this value.
#TELESCOPE_QUEUE_MAX_BYTES=536870912
